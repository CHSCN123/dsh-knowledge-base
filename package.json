{
  "name": "dsh-knowledge-base",
  "version": "0.3.0",
  "description": "Local Markdown knowledge base for DSH: drop files in Settings to turn them into searchable notes.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "knowledge-base",
    "markdown"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-rc.1 || ^0.1.7-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHSCN123/dsh-knowledge-base.git"
  },
  "homepage": "https://github.com/CHSCN123/dsh-knowledge-base#readme"
}
